{
    "manifest_version": 3,
    "name": "Highlight Saver",
    "description": "Save your highlighted text.",
    "version": "1.0",
    "permissions": [
      "storage","activeTab"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_popup": "popup/popup.html"
    },
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ]
  }
  